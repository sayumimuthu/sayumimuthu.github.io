@inproceedings{muthukumarana2026promptsensitivity,
  abbr        = {MERCon},
  bibtex_show = {true},
  selected    = {true},
  title       = {Prompt Sensitivity or Evaluation Artifact? A Task-Aware Analysis for Large Language Models},
  author      = {Muthukumarana, Sayumi and Wijenayake, Buddhi and Godaliyadda, Roshan and Ekanayake, Parakrama},
  booktitle   = {2026 12th IEEE Moratuwa Engineering Research Conference (MERCon)},
  location    = {Moratuwa, Sri Lanka},
  year        = {2026},
  month       = aug,
  html        = {https://ieeexplore.ieee.org/document/11691277},
  code        = {https://github.com/sayumimuthu/llm-prompt-sensitivity-evaluation-artifact},
  preview     = {prompt_sensitivity.jpg},
  abstract    = {Is the variation in LLM outputs across prompt templates a property of the model, or partly an artifact of how responses are scored? We design an eight-template evaluation experiment spanning ARC-Challenge, BoolQ and SQuAD, covering nine LLMs and 43,200 prompt-response-judge triples. We introduce Evaluation-Attributable Sensitivity (EAS) and Signed EAS to separate genuine generation variation from differences introduced by heuristic scoring and LLM-as-judge evaluation, and examine how benchmark format and scoring method affect observed sensitivity, identifying contexts in which automatic metrics under- or over-estimate response instability.<br><br><strong>My contribution:</strong> Conceptualization; formulation and analysis of evaluation-attributable sensitivity across controlled LLM experiments; quantitative evaluation; writing (original draft, review and editing).}
}

@article{muthukumarana2026onceuponabias,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  title       = {Once Upon a Bias: Gender Stereotyping in LLM-Generated Children's Stories},
  author      = {Muthukumarana, Sayumi and Godaliyadda, Roshan and Ekanayake, Parakrama and Ragel, Roshan},
  journal     = {arXiv preprint},
  year        = {2026},
  code        = {https://github.com/sayumimuthu/Bias-Detection-in-LLMs},
  preview     = {gender_stories.jpg},
  abstract    = {We study how the gender of an intended child and the identity of the narrator shape character traits and social-role portrayals in children's stories generated by large language models. Using matched daughter-son comparisons, we combine agency/communion and trait lexicons, matched interaction analyses and human assessments of narrative differences. Through probing and activation interventions, we further examine whether recipient information encoded in model hidden states has a causal influence on generated portrayals, distinguishing decodability from demonstrated causation.<br><br><strong>My contribution:</strong> Conceptualization; experimental design; dataset curation; quantitative evaluation; writing (original draft, review and editing).}
}

@unpublished{adhikari2026absorb,
  abbr        = {ICLR},
  selected    = {true},
  title       = {ABSORB: Absorbing-State Discrete Diffusion for Single-Cell Gene Expression Imputation},
  author      = {Adhikari, Chandula and Muthukumarana, Sayumi and Godaliyadda, Roshan and Ekanayake, Parakrama},
  note        = {Under review at ICLR 2027},
  year        = {2026},
  preview     = {absorb.jpg},
  abstract    = {Zero counts in single-cell RNA sequencing are ambiguous: some reflect missing transcript measurements (dropout), others are biologically meaningful. ABSORB treats dropout as masked missingness and performs selective imputation with an absorbing [MASK]-state discrete diffusion formulation, using per-gene quantile tokenization, a role-conditioned Transformer, fixed observed context and confidence-ordered parallel reconstruction.<br><br><strong>My contribution:</strong> Research on modeling dropout as masked missingness; experimental evaluation; writing (original draft, review and editing).}
}

@unpublished{muthukumarana2026hallucinationslr,
  abbr        = {CL},
  selected    = {true},
  title       = {Internal Representations for Hallucination Detection and Mitigation in Large Language Models: A Systematic Literature Review},
  author      = {Muthukumarana, Sayumi and Ekanayake, Marlon and Godaliyadda, Roshan and Ekanayake, Parakrama},
  note        = {Under review at Computational Linguistics},
  year        = {2026},
  preview     = {hallucination.jpg},
  abstract    = {A systematic literature review of methods that use the internal representations of large language models to detect and mitigate hallucinations.<br><br><strong>My contribution:</strong> Conceptualization; development of search criteria; full-text screening; synthesis; writing (original draft, review and editing).}
}
